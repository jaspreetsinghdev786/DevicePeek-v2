{
  "manifest_version": 3,
  "name": "Peak Preview – Mobile & Desktop Viewer",
  "short_name": "Peak Preview",
  "version": "1.1.0",
  "description": "A floating, movable mobile preview of the page you're on – plus a side-by-side device workspace and exact device mode.",
  "minimum_chrome_version": "116",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage",
    "debugger",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Peak Preview – floating mobile preview",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/emulate.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/bridge.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Show or hide the floating mobile preview"
    },
    "open-compare": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Open the comparison workspace for the current page"
    }
  }
}
